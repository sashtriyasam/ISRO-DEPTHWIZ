# DepthWizard — data / artifact ignore
# Never commit raw GAMUS or derived large artifacts

# Raw datasets
data/raw/
data/gamus/
data/GAMUS/
*.h5
*.hdf5
*.tif
*.tiff

# Hugging Face / ML caches
.cache/
hf_cache/
**/.cache/huggingface/
**/huggingface/

# Checkpoints / predictions
checkpoints/
*.ckpt
*.pth
*.pt
*.bin
predictions/
outputs/

# CUDA / temp
*.cuda
*.tmp
*.archive

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Manifests: keep manifests/*.json tracked, ignore generated temp manifests
manifests/*.tmp.json
manifests/*.local.json

# Local overrides — commit example, never personal config
configs/local*.json
configs/*.local.json

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
